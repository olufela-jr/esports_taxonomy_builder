rules_version = '2';

// v3 tenancy. Every document lives under tenants/{tenantId}; the caller's
// tenantId claim must match the path for any read or write, and only the
// admin role writes Rule Sets. The tenant document and the users mirror are
// written by the provisioning scripts only. Outside tenants/ only
// accessRequests/ matches (a person asking for access has no tenant yet), so
// the legacy /rulesets collection and every other path are denied.
//
// The rules language cannot loop over the inline Rules, so anything about
// their content is checked by checkRuleSet in @taxo/shared before every save;
// here we only check the coarse shape and the audit fields.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Membership comes from the custom claims on the token, never from data.
    function inTenant(tenantId) {
      return signedIn() && request.auth.token.tenantId == tenantId;
    }

    function isAdmin(tenantId) {
      return inTenant(tenantId) && request.auth.token.role == 'admin';
    }

    // The super user (a separate claim, set only by the provisioning script)
    // reads every tenant. Writes inside a tenant still need the admin role
    // there (D35: cross-tenant is additive, never a relaxation of writes);
    // tenants themselves are created and edited through the Functions.
    function isSuper() {
      return signedIn() && request.auth.token.superuser == true;
    }

    // Anyone who may read inside this tenant: a member, or the super user.
    function canRead(tenantId) {
      return inTenant(tenantId) || isSuper();
    }

    function wellFormed(data) {
      return data.id is string
        && data.name is string
        && data.rules is list
        && data.createdAt is string
        && data.updatedAt is string
        && data.createdBy is string
        && data.updatedBy is string;
    }

    // Every write records who made it (D31).
    function stampedByCaller(data) {
      return data.updatedBy == request.auth.uid;
    }

    // A standard user's request for a new entry (v3 D41): coarse shape only.
    function wellFormedRequest(data) {
      return data.id is string
        && data.definitionId is string
        && data.label is string
        && data.code is string
        && data.note is string
        && data.requestedByName is string
        && data.status in ['pending', 'approved', 'rejected']
        && data.reason is string
        && (!('draftId' in data) || data.draftId is string)
        && data.createdAt is string
        && data.updatedAt is string
        && data.createdBy is string
        && data.updatedBy is string;
    }

    // A Build draft waiting on a request (v3 D42): coarse shape only.
    function wellFormedDraft(data) {
      return data.id is string
        && data.ruleSetId is string
        && data.ruleId is string
        && data.selections is map
        && data.parentName is string
        && data.blockedSegmentId is string
        && data.blockedSegmentKey is string
        && data.requestId is string
        && data.status in ['blocked', 'ready', 'done']
        && data.createdAt is string
        && data.updatedAt is string
        && data.createdBy is string
        && data.updatedBy is string;
    }

    // A shared definition (v3 phase 2): coarse shape only; checkDefinition in
    // @taxo/shared checks the entries and platforms before every save.
    function wellFormedDefinition(data) {
      return data.id is string
        && data.name is string
        && data.platforms is list
        && data.entries is list
        && data.createdAt is string
        && data.updatedAt is string
        && data.createdBy is string
        && data.updatedBy is string;
    }

    // Access requests from signed-in accounts with no workspace yet, keyed by
    // uid so an account has at most one. The requester reads their own (the
    // waiting screen follows it live), the super user reads all to decide them,
    // and only the access-request Functions write.
    match /accessRequests/{uid} {
      allow read: if isSuper() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /tenants/{tenantId} {
      // The tenant document: name and config (allowed datasets, platforms).
      // The super user lists the whole collection for the Tenants screen.
      allow read: if canRead(tenantId);
      allow write: if false;

      // A readable mirror of the claims; the claims are the truth. Written
      // only by the membership Functions and the provisioning script.
      match /users/{uid} {
        allow read: if isSuper() || (inTenant(tenantId) && (request.auth.uid == uid || isAdmin(tenantId)));
        allow write: if false;
      }

      // Invites an admin has sent (the admin section): admins read them,
      // only the membership Functions write them, and the person invited
      // never sees the document, their sign-in claims it server-side.
      match /invites/{inviteId} {
        allow read: if isAdmin(tenantId) || isSuper();
        allow write: if false;
      }

      match /rulesets/{ruleSetId} {
        allow read: if canRead(tenantId);
        allow create: if isAdmin(tenantId)
          && wellFormed(request.resource.data)
          && request.resource.data.id == ruleSetId
          && request.resource.data.createdBy == request.auth.uid
          && stampedByCaller(request.resource.data);
        allow update: if isAdmin(tenantId)
          && wellFormed(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && stampedByCaller(request.resource.data);
        allow delete: if isAdmin(tenantId);
      }

      // The tenant's shared definitions: any member reads, only an admin writes.
      match /definitions/{definitionId} {
        allow read: if canRead(tenantId);
        allow create: if isAdmin(tenantId)
          && wellFormedDefinition(request.resource.data)
          && request.resource.data.id == definitionId
          && request.resource.data.createdBy == request.auth.uid
          && stampedByCaller(request.resource.data);
        allow update: if isAdmin(tenantId)
          && wellFormedDefinition(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && stampedByCaller(request.resource.data);
        allow delete: if isAdmin(tenantId);
      }

      // Requests for new entries: any member submits their own, pending; only
      // the requester or an admin reads one (a member's list must be filtered
      // to their own); only an admin changes it, and the requester never moves.
      match /requests/{requestId} {
        allow read: if isAdmin(tenantId) || isSuper() || (inTenant(tenantId) && resource.data.createdBy == request.auth.uid);
        allow create: if inTenant(tenantId)
          && wellFormedRequest(request.resource.data)
          && request.resource.data.id == requestId
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid
          && stampedByCaller(request.resource.data);
        allow update: if isAdmin(tenantId)
          && wellFormedRequest(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && stampedByCaller(request.resource.data);
        allow delete: if isAdmin(tenantId);
      }

      // Build drafts: a member creates, updates and deletes their own; an admin
      // reads every one and updates one (to mark it ready on approval); the
      // owner never moves.
      match /drafts/{draftId} {
        allow read: if isAdmin(tenantId) || isSuper() || (inTenant(tenantId) && resource.data.createdBy == request.auth.uid);
        allow create: if inTenant(tenantId)
          && wellFormedDraft(request.resource.data)
          && request.resource.data.id == draftId
          && request.resource.data.createdBy == request.auth.uid
          && stampedByCaller(request.resource.data);
        allow update: if (isAdmin(tenantId) || (inTenant(tenantId) && resource.data.createdBy == request.auth.uid))
          && wellFormedDraft(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && stampedByCaller(request.resource.data);
        allow delete: if isAdmin(tenantId) || (inTenant(tenantId) && resource.data.createdBy == request.auth.uid);
      }
    }
  }
}
