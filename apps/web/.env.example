# Copy to .env.local and fill in from the Firebase console
# (Project settings > General > Your apps > Web app > SDK setup and configuration).
# Leave every VITE_FIREBASE_* line empty to run on the in-memory store
# (development and tests only; a production build refuses to start without them).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to "memory" to ignore the Firebase config above during development.
# VITE_STORE=memory
